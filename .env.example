# Copy this file to .env and adjust the values for your machine.
# These are local-development placeholders. Never commit real credentials.

# PostgreSQL / PostGIS — read by Docker Compose and by the backend
POSTGRES_USER=farm2local
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=farm2local
POSTGRES_HOST=localhost
# Host port published by Docker Compose. 5433 avoids a clash with a
# PostgreSQL instance that is already listening on the default 5432.
POSTGRES_PORT=5433

# Host port for the FastAPI backend container
BACKEND_PORT=8000

# Authentication
# Signs access tokens; must be at least 32 characters. Replace the placeholder
# with your own random value, for example the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_replace_with_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=60
